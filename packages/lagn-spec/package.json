{
  "name": "@legendary-arena/lagn",
  "version": "1.1.0",
  "description": "Legendary Arena Game Notation — validator, derived JSON Schema, and CLI",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "lagn": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./schemas/lagn-v1.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs && node scripts/generate-schema.mjs",
    "generate:schema": "tsc && node scripts/generate-schema.mjs",
    "test": "tsx --test src/validator.test.ts"
  },
  "keywords": [
    "legendary-arena",
    "game-notation",
    "json-schema",
    "validation"
  ],
  "author": "Legendary Arena Contributors",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
