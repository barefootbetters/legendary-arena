                    "card_ext_id"
                  ],
                  "additionalProperties": true
                }
              },
              "player_actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "action_type": {
                      "type": "string",
