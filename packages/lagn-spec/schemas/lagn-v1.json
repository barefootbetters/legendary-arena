                        "villain_reveal",
                        "villain_attack",
                        "villain_escape",
                        "hero_recruit",
                        "hero_play",
                        "hero_discard",
                        "mastermind_twist",
                        "mastermind_attack",
                        "bystander_capture",
                        "bystander_release",
                        "wound_dealt",
                        "shield_deploy"
                      ]
                    },
                    "actor_player_id": {
                      "type": "string"
                    },
                    "target_card_ext_id": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "seq",
                    "action_type"
                  ],
                  "additionalProperties": true
                }
              },
              "stage_transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "enum": [
                        "start",
                        "main",
                        "cleanup"
                      ]
                    },
                    "to": {
                      "type": "string",
                      "enum": [
                        "start",
                        "main",
                        "cleanup"
                      ]
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "turn_number",
              "active_player_id"
            ],
            "additionalProperties": true
