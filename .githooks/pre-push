#!/bin/sh
# pre-push hook — two local gates before a push reaches GitHub:
#
#   Gate 1 (every push): ledger-freshness guard. Refuse a push that changes the
#   number ledger / DECISIONS when origin/main has ALSO changed them since the
#   branch diverged — a stale ledger base silently re-introduces duplicate
#   reservations that only surface as a red "Coverage & Ledger Gates" check
#   after CI runs. Blocking here turns that late failure into an immediate
#   "rebase onto origin/main" locally.
#
#   Gate 2 (main pushes only): CI-equivalent build + typecheck + dashboard
#   lint/test/format, closing the unprotected-main bypass (see the block below).
#
# Emergency escape hatch for both gates: git push --no-verify.

# why: build the escape sequences via printf so the variables hold real ESC
# bytes — `echo` does not interpret backslash escapes portably across sh
# implementations, and this hook prints on every successful main push (not just
# on failure), so literal `\033[...]` garbage would show otherwise.
RED=$(printf '\033[0;31m')
GREEN=$(printf '\033[0;32m')
YELLOW=$(printf '\033[0;33m')
NC=$(printf '\033[0m')

# why: an all-zero local sha marks a branch deletion — there is nothing to
# check, so such refs are skipped by both gates.
ZERO_SHA='0000000000000000000000000000000000000000'

# why: a pre-push hook receives its ref list on stdin, which can be read only
# once. Capture it so both gates can iterate the same refs (each via a heredoc
# redirect, NOT a pipe, so the loop runs in this shell and its variables
# survive — a piped `while` runs in a subshell and would lose them).
PUSH_REFS=$(cat)

# why: hooks already run from the worktree top, but anchor explicitly so the
# git and pnpm workspace commands resolve regardless of how the push was invoked.
TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$TOPLEVEL" ]; then
  cd "$TOPLEVEL" || exit 1
fi

# why: the ledger append-files. Concurrent sessions both append reservations
# here, so they are the files where a stale base re-introduces a duplicate.
LEDGER_PATTERN='docs/ai/(NUMBER-LEDGER|DECISIONS)\.md'

# --- Gate 1: ledger-freshness guard (every push) --------------------------

# why: cheap pre-filter — only pay for a network fetch when this push actually
# changes a ledger file. Compared against the LOCAL origin/main (possibly
# stale); that is fine here because a branch that ADDS a ledger entry shows the
# change regardless of how stale the local base is.
push_touches_ledger=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO_SHA" ] && continue
  base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || continue
  if git diff --name-only "$base" "$local_sha" 2>/dev/null | grep -qE "$LEDGER_PATTERN"; then
    push_touches_ledger=1
  fi
done <<EOF
$PUSH_REFS
EOF

if [ "$push_touches_ledger" -eq 1 ]; then
  # why: fetch origin/main once so the comparison is against the LIVE tip — the
  # whole failure mode is a base that went stale while a concurrent reservation
  # merged. A failed fetch (offline) is non-fatal: warn and skip rather than
  # block a legitimate push with no network.
  if git fetch --quiet origin main 2>/dev/null; then
    ledger_conflict=0
    while read -r local_ref local_sha remote_ref remote_sha; do
      [ "$local_sha" = "$ZERO_SHA" ] && continue
      merge_base=$(git merge-base "$local_sha" FETCH_HEAD 2>/dev/null) || continue
      branch_changed=$(git diff --name-only "$merge_base" "$local_sha" 2>/dev/null | grep -E "$LEDGER_PATTERN")
      main_changed=$(git diff --name-only "$merge_base" FETCH_HEAD 2>/dev/null | grep -E "$LEDGER_PATTERN")
      if [ -n "$branch_changed" ] && [ -n "$main_changed" ]; then
        ledger_conflict=1
      fi
    done <<EOF
$PUSH_REFS
EOF

    if [ "$ledger_conflict" -eq 1 ]; then
      echo ""
      echo "${RED}PUSH BLOCKED:${NC} this push and origin/main have both changed the number ledger / DECISIONS since they diverged."
      echo "  A stale ledger base re-introduces duplicate reservations — a red ${YELLOW}Coverage & Ledger Gates${NC} check that only shows up after CI."
      echo "  Fix: ${GREEN}git fetch origin main && git rebase origin/main${NC}, re-check ${GREEN}pnpm ledger:numbers:check${NC}, then push."
      echo "  Bypass (only if you are certain your reservation does not overlap): git push --no-verify"
      echo ""
      exit 1
    fi
  else
    echo "${YELLOW}pre-push:${NC} could not fetch origin/main — skipping the ledger-freshness check (offline?)."
  fi
fi

# --- Gate 2: CI-equivalent gate for main pushes ---------------------------

pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO_SHA" ] && continue
  if [ "$remote_ref" = "refs/heads/main" ]; then
    pushing_main=1
  fi
done <<EOF
$PUSH_REFS
EOF

if [ "$pushing_main" -eq 0 ]; then
  exit 0
fi

echo "${YELLOW}pre-push:${NC} push updates main — running CI-equivalent gate (build + typecheck + dashboard lint/test/format)."
echo "          emergency bypass: git push --no-verify"

run_gate() {
  echo ""
  echo "→ pnpm -r build"
  pnpm -r build || return 1
  echo ""
  echo "→ pnpm --filter registry-viewer typecheck"
  pnpm --filter registry-viewer typecheck || return 1
  echo ""
  echo "→ pnpm --filter @legendary-arena/arena-client typecheck"
  pnpm --filter @legendary-arena/arena-client typecheck || return 1
  echo ""
  echo "→ pnpm --filter @legendary-arena/dashboard typecheck"
  pnpm --filter @legendary-arena/dashboard typecheck || return 1
  # why: the dashboard ships the most CI gates and has repeatedly drifted red to
  # an unprotected main — vue-tsc (above) AND format:check (WP-230 shipped
  # un-prettier'd files that sat red on main). Mirror the rest of CI's Dashboard
  # Gates job locally so a main push cannot land those red: lint, the
  # coverage-gated test suite, and the prettier format check. `pnpm -r build`
  # above already ran the dashboard build, which generates the governance
  # snapshot these steps import.
  echo ""
  echo "→ pnpm --filter @legendary-arena/dashboard lint"
  pnpm --filter @legendary-arena/dashboard lint || return 1
  echo ""
  echo "→ pnpm --filter @legendary-arena/dashboard test:coverage"
  pnpm --filter @legendary-arena/dashboard test:coverage || return 1
  echo ""
  echo "→ pnpm --filter @legendary-arena/dashboard format:check"
  pnpm --filter @legendary-arena/dashboard format:check || return 1
  return 0
}

if run_gate; then
  echo ""
  echo "${GREEN}pre-push: CI-equivalent gate passed.${NC}"
  exit 0
fi

echo ""
echo "${RED}PUSH BLOCKED:${NC} build, typecheck, lint, test, or format check failed — fix before pushing to main."
echo "Re-run the failing step shown above, or bypass with: git push --no-verify"
echo ""
exit 1
