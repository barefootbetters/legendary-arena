/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# why: no explicit Cache-Control rule for the HTML entry document (index.html,
# which Cloudflare Pages also serves for every SPA route via _redirects).
# Cloudflare Pages' platform default for HTML is already
# `public, max-age=0, must-revalidate`, so the browser revalidates the entry
# document on every navigation and always sees the current content-hashed chunk
# references after a redeploy. A `no-cache` rule here would be redundant with
# that default. Only the hashed /assets/* chunks are marked immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
