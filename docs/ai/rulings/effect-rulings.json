  {
    "id": "melter-park-kos-nothing",
    "mechanic": "ko-cullable-each-deck-top",
    "decision": "D-24413",
    "scenario": {
      "action": "fire-villain-effect",
      "setup": {
        "cardId": "core/masters-of-evil/melter#0",
        "timing": "onFight",
        "currentPlayer": "0",
        "descriptor": { "primitive": "ko-cullable-each-deck-top" },
        "playerZones": {
          "0": { "deck": ["pile-wound", "core/wolverine/wolverine#0"] },
          "1": { "deck": ["core/spider-man/spider-man#0"] }
        }
      }
    },
    "expected": { "kind": "ko-pile-equal", "cards": [] },
    "why": "Melter's Fight is now an interactive per-card KO/keep choice (D-24413, superseding the D-24332 auto-resolve): revealing the deck tops KOs nothing at park time — the KO waits for the player's resolve. The old auto-resolve would have culled the revealed Wound immediately."
  },
  {
