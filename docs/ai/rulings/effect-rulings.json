  {
    "id": "optional-ko-reward-kos-in-play-card",
    "mechanic": "optional-ko-reward",
    "decision": "D-24442",
    "scenario": {
      "action": "resolve-optional-ko-reward",
      "setup": {
        "currentPlayer": "0",
        "pending": { "rewardType": "rescue", "rewardMagnitude": 1, "sourceCardId": "core/black-widow/dangerous-rescue#0" },
        "inPlay": ["starting-shield-agent"],
        "bystandersSupply": 1,
        "resolve": { "zone": "inPlay", "cardId": "starting-shield-agent" }
      }
    },
    "expected": { "kind": "ko-pile-equal", "cards": ["starting-shield-agent"] },
    "why": "The optional-ko-reward KO source now includes in-play (hand union discard union in-play): a card played this turn can be KO'd for the reward — the classic deck-thinning play the printed hand-or-discard wording excluded (D-24442)."
  },
  {
    "id": "optional-ko-reward-in-play-fires-reward",
    "mechanic": "optional-ko-reward",
    "decision": "D-24442",
    "scenario": {
      "action": "resolve-optional-ko-reward",
      "setup": {
        "currentPlayer": "0",
        "pending": { "rewardType": "rescue", "rewardMagnitude": 1, "sourceCardId": "core/black-widow/dangerous-rescue#0" },
        "inPlay": ["starting-shield-agent"],
        "bystandersSupply": 1,
        "resolve": { "zone": "inPlay", "cardId": "starting-shield-agent" }
      }
    },
    "expected": { "kind": "zone-cards-equal", "player": "0", "zone": "victory", "cards": ["pile-bystander"] },
    "why": "KO'ing an in-play card still dispatches the reward (here rescue, moving one Bystander to the Victory pile); the KO does not claw back the value the played card already produced (D-24442)."
  },
